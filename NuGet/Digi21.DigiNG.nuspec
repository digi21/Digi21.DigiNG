<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/01/nuspec.xsd">
	<metadata>
		<id>Digi21.DigiNG</id>
		<version>26.0.0</version>
		<title>Digi21.DigiNG</title>
		<authors>José Ángel Martínez Torres</authors>
		<owners></owners>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<license type="expression">MIT</license>
		<readme>README.md</readme>
		<icon>IconoDigi21.png</icon>
		<projectUrl>https://digi3d.net/</projectUrl>
		<description>This package contains reference assemblies with types for developing applications with the Digi3D.AI engine.

A Digi3D.AI license is required to run applications that use the assemblies published by this package. Rent a license at https://www.digi21.net/Tienda/Alquiler or buy a license at https://www.digi21.net/Tienda/Compra
		</description>
		<releaseNotes>Please visit https://www.digi21.net/Digi3D/Download to see the release notes.</releaseNotes>
		<copyright>(c) 2000-2026 Dreaming With Objects S.L.</copyright>
		<tags>Digi3D, Digi3D.AI, Digi21, Digi</tags>
		<repository type="git" url="https://github.com/digi21/Digi21.DigiNG.git" />
		<dependencies>
			<group targetFramework="net10.0"/>
		</dependencies>
	</metadata>
	<files>
		<file src="..\Digi21.DigiNG\obj\Release\net10.0\ref\Digi21.DigiNG.dll" target="ref\net10.0\Digi21.DigiNG.dll" />
		<file src="buildTransitive\Digi21.DigiNG.targets" target="buildTransitive\Digi21.DigiNG.targets" />
		<file src="buildTransitive\Digi3DAssemblyResolver.cs" target="buildTransitive\Digi3DAssemblyResolver.cs" />
		<file src="IconoDigi21.png" target="IconoDigi21.png" />
		<file src="README.md" target="README.md" />
	</files>
</package>